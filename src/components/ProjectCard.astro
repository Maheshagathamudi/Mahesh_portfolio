---
interface Props {
  title: string;
  description: string;
  tags: string[];
  github?: string;
  live?: string;
  image: string;
}

const { title, description, github, live, image } = Astro.props;
import { Github, ExternalLink } from "lucide-astro";
---

<article class="project-card" data-animate="fade-up">
  <div class="project-card-image" aria-hidden="true">
    {image ? (
      <img src={image} alt="" class="project-img" loading="lazy" />
    ) : (
      <div class="project-image-fallback"></div>
    )}
  </div>

  <div class="project-links" aria-label={`${title} links`}>
    {live ? (
      <a href={live} target="_blank" rel="noopener noreferrer" class="project-link project-link-live" aria-label={`View live ${title} demo`}>
        <ExternalLink size={15} strokeWidth={2} />
        Live Demo
      </a>
    ) : null}
    {github ? (
      <a href={github} target="_blank" rel="noopener noreferrer" class="project-link project-link-code" aria-label={`View ${title} on GitHub`}>
        <Github size={15} strokeWidth={2} />
        GitHub
      </a>
    ) : null}
  </div>

  <div class="project-card-body">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</article>
