---
import { profile } from "../data/portfolio";
import { Github, Linkedin, Mail } from "lucide-astro";
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo-group">
          <span class="footer-logo-initials">{profile.initials}</span>
          <div class="footer-logo-meta">
            <span class="footer-logo-name">{profile.name}</span>
            <span class="footer-logo-role">{profile.role}</span>
          </div>
        </div>
        <p class="footer-tagline">Building scalable software applications, intelligent systems, and robust cloud architectures.</p>
      </div>
      
      <div class="footer-socials">
        <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">
          <Github size={20} strokeWidth={1.5} />
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <Linkedin size={20} strokeWidth={1.5} />
        </a>
        <a href={`mailto:${profile.email}`} aria-label="Email">
          <Mail size={20} strokeWidth={1.5} />
        </a>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} {profile.name}. All rights reserved.
      </p>
      <p class="footer-credit">
        Handcrafted with <span class="heart">💜</span> and Astro
      </p>
    </div>
  </div>
</footer>
