---
import { profile, stats } from "../data/portfolio";
import { ArrowRight, FileText } from "lucide-astro";
---

<section class="showcase" id="home">
  <!-- Subtle background glows for the entire showcase area -->
  <div class="about-glow glow-orange"></div>
  <div class="about-glow glow-green"></div>

  <!-- LEFT: Profile Card Column -->
  <div class="showcase-left">
    <div class="profile-card" data-animate="fade-right">
      <!-- Rectangular Photo Area at Top -->
      <div class="card-photo">
        <img src="/Mahesh.png" alt="Agathamudi Mahesh" />
      </div>

      <div class="card-body">
        <h2>Agathamudi Mahesh</h2>
        <span class="badge-status">🔥 {profile.tagline}</span>

        <p class="bio">{profile.bio}</p>

        <div class="social-links">
          <!-- Official GitHub Icon -->
          <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="github-link">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="#181717"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <!-- Official LinkedIn Icon -->
          <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="linkedin-link">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="#0a66c2"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <!-- Official Gmail Icon -->
          <a href={`mailto:${profile.email}`} aria-label="Email" class="gmail-link">
            <svg width="23" height="23" viewBox="52 42 88 66">
              <path fill="#4285f4" d="M58 108h14V74L52 59v43c0 3.32 2.69 6 6 6"/>
              <path fill="#34a853" d="M120 108h14c3.32 0 6-2.69 6-6V59l-20 15"/>
              <path fill="#fbbc04" d="M120 48v26l20-15v-8c0-7.42-8.47-11.65-14.4-7.2"/>
              <path fill="#ea4335" d="M72 74V48l24 18 24-18v26L96 92"/>
            </svg>
          </a>
          <!-- Official WhatsApp Icon -->
          <a href="https://wa.me/919392653912" target="_blank" rel="noopener" aria-label="WhatsApp" class="whatsapp-link">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="#25d366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT: Content Column (Hero Content + About Content) -->
  <div class="showcase-right">
    <!-- Part 1: Hero Content -->
    <div class="hero-content">
      <div class="hero-text" data-animate="fade-up">
        <h1>
          Software <span>Engineer</span>
        </h1>
      </div>

      <!-- Stats -->
      <div class="hero-stats" data-animate="fade-up">
        {stats.map((stat) => (
          <div class="stat-item">
            <h3>{stat.value}</h3>
            <p>{stat.label}</p>
          </div>
        ))}
      </div>

      <!-- Floating Dynamic Badges with Icons -->
      <div class="floating-badges" data-animate="fade-up">
        <div class="badge-pill large">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pytorch/pytorch-original.svg" alt="PyTorch" width="16" height="16" style="margin-right:8px; vertical-align:-2px; display:inline-block;" />
          AI AGENT ENGINEERING
        </div>
        <div class="badge-pill large accent-alt">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" alt="React" width="16" height="16" style="margin-right:8px; vertical-align:-2px; display:inline-block;" />
          FULL-STACK DEVELOPMENT
        </div>

        <div class="badge-pill small-pills">
          <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apacheairflow/apacheairflow-original.svg" alt="Airflow" width="14" height="14" style="margin-right:6px; vertical-align:-2px; display:inline-block;" /> AI + AUTOMATION</span>
          <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apachespark/apachespark-original.svg" alt="Spark" width="14" height="14" style="margin-right:6px; vertical-align:-2px; display:inline-block;" /> DATA ENGINEERING</span>
          <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" width="14" height="14" style="margin-right:6px; vertical-align:-2px; display:inline-block;" /> PYTHON</span>
          <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" alt="PostgreSQL" width="14" height="14" style="margin-right:6px; vertical-align:-2px; display:inline-block;" /> SQL</span>
          <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-plain.svg" alt="Kubernetes" width="14" height="14" style="margin-right:6px; vertical-align:-2px; display:inline-block;" /> CLOUD & DEVOPS</span>
          <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/grafana/grafana-original.svg" alt="Grafana" width="14" height="14" style="margin-right:6px; vertical-align:-2px; display:inline-block;" /> DATA ANALYTICS</span>
        </div>
      </div>

      <!-- CTAs -->
      <div class="hero-cta" data-animate="fade-up">
        <a href="#projects" class="btn-primary">
          View Projects <ArrowRight size={18} strokeWidth={2.5} />
        </a>
        <a href={profile.resumeUrl} target="_blank" rel="noopener" class="btn-outline">
          <FileText size={18} strokeWidth={2} /> Resume
        </a>
        <a href="#contact" class="btn-outline">
          Let's Talk
        </a>
      </div>
    </div>

    <!-- Part 2: About Content -->
    <div class="about-content-wrapper" id="about">
      <!-- Section Header -->
      <div class="about-header" data-animate="fade-up">
        <h2 class="about-title">
          Building Systems<br />
          That <span class="text-gradient">Scale</span>
        </h2>
      </div>

      <!-- Introduction -->
      <div class="about-intro" data-animate="fade-up">
        <p>
          I build intelligent software systems that combine AI, automation, cloud infrastructure, and scalable web technologies to solve real-world engineering problems.
        </p>
      </div>

      <!-- Personal Story -->
      <div class="about-story" data-animate="fade-up">
        <p>
          With a foundation in Computer Science, I've grown from writing my first scripts to architecting distributed systems and autonomous AI workflows. What drives me is the challenge of turning messy, complex processes into clean, automated solutions that just work.
        </p>
        <p>
          Today, I work across the full spectrum — from designing data pipelines and deploying cloud infrastructure to building intelligent agents that reason, retrieve, and act. Every project is an opportunity to ship something that's fast, reliable, and built to last.
        </p>
      </div>

      <!-- Focus Area Badges -->
      <div class="focus-badges" data-animate="fade-up">
        <span class="focus-badge">AI Agents</span>
        <span class="focus-badge">Full Stack</span>
        <span class="focus-badge">Data Engineering</span>
        <span class="focus-badge">Cloud & DevOps</span>
        <span class="focus-badge">Automation</span>
      </div>

      <!-- Closing Callout -->
      <div class="about-callout" data-animate="fade-up">
        <p>
          "I enjoy building software that transforms complex workflows into scalable, reliable, production-ready systems."
        </p>
      </div>
    </div>
  </div>
</section>
